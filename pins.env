# Pinned dev-tooling versions, each recorded in one place. `RUSTFMT_NIGHTLY` is
# the nightly toolchain whose rustfmt runs the comment-reflow check in
# `tools/tidy.sh` (`wrap_comments` is nightly-only). `rust-toolchain.toml` pins
# the stable channel alone, so the reflow nightly needs its own pin here rather
# than floating on the latest, where a change to rustfmt's wrapping fails the
# check on an untouched tree. Bumping it re-reflows the tree in the same commit,
# so a wrap change is a deliberate bump.
RUSTFMT_NIGHTLY=nightly-2026-08-30

# The git-cliff release that generates a release's notes from the commit
# history (cliff.toml, tools/changelog.sh). Pinned so a preview run locally
# and the release workflow produce the same text.
GIT_CLIFF_VERSION=2.14.2
