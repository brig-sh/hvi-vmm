<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for any Hypervisor.framework use (hv_vm_create et al). -->
	<key>com.apple.security.hypervisor</key>
	<true/>
	<!-- Not needed: virtio-net runs a user-space stack, a gvisor-tap relay or a
	     Linux tap, none of which touches vmnet. Uncomment only for a vmnet
	     backend, which would also need a Developer ID signature.
	<key>com.apple.vm.networking</key>
	<true/>
	-->
</dict>
</plist>
