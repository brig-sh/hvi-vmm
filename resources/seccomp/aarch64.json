{
    "vmm": {
        "default_action": "trap",
        "filter_action": "allow",
        "filter": [
            {"syscall": "read", "comment": "console stdin, tap and gateway readers"},
            {"syscall": "write", "comment": "guest console to stdout, event ledger"},
            {"syscall": "pread64", "comment": "virtio-blk reads from the backing file"},
            {"syscall": "pwrite64", "comment": "virtio-blk writes to the backing file"},
            {"syscall": "readv", "comment": "safety net: std may vector a buffered read"},
            {"syscall": "writev", "comment": "safety net: BufWriter flush of the ledger"},
            {"syscall": "lseek", "comment": "safety net: File::seek on the backing file"},
            {"syscall": "fdatasync", "comment": "virtio-blk flush: what File::sync_data calls"},
            {"syscall": "fsync", "comment": "safety net: sync_all, if a flush ever needs metadata"},
            {"syscall": "close", "comment": "accepted connections, dropped descriptors"},
            {"syscall": "fcntl", "comment": "set_nonblocking on accepted sockets"},
            {"syscall": "ioctl", "comment": "KVM_RUN and friends; TUNSETIFF is pre-filter"},
            {"syscall": "accept4", "comment": "control socket and the agent bridge"},
            {"syscall": "recvfrom", "comment": "agent bridge reads"},
            {"syscall": "recvmsg", "comment": "safety net: the control protocol's receive side"},
            {"syscall": "sendmsg", "comment": "SCM_RIGHTS: guest-RAM fd to a plugin consumer"},
            {"syscall": "sendto", "comment": "safety net: UnixStream::write lowers to this"},
            {"syscall": "eventfd2", "comment": "KVM irqfd/ioeventfd wiring"},
            {"syscall": "clone", "comment": "a reader thread per accepted vsock connection"},
            {"syscall": "clone3", "comment": "same, on a glibc new enough to use it"},
            {"syscall": "futex", "comment": "every Mutex, Condvar and thread join"},
            {"syscall": "mmap", "comment": "thread stacks and allocator growth"},
            {"syscall": "munmap", "comment": "thread teardown and allocator release"},
            {"syscall": "mprotect", "comment": "thread stack guard pages"},
            {"syscall": "mremap", "comment": "safety net: realloc of a large buffer"},
            {"syscall": "madvise", "comment": "allocator returning pages"},
            {"syscall": "brk", "comment": "glibc malloc for small allocations"},
            {"syscall": "ppoll", "comment": "the plugin waker, the readers and any timer thread"},
            {"syscall": "clock_nanosleep", "comment": "a plugin thread that wakes on a timer"},
            {"syscall": "clock_gettime", "comment": "safety net: event timestamps if vDSO is bypassed"},
            {"syscall": "sched_yield", "comment": "safety net: Mutex contention path"},
            {"syscall": "sched_getaffinity", "comment": "std thread startup"},
            {"syscall": "getrandom", "comment": "HashMap seeding on first use"},
            {"syscall": "getpid", "comment": "the tgkill vCPU kick"},
            {"syscall": "gettid", "comment": "std thread startup"},
            {"syscall": "tgkill", "comment": "kicking a vCPU out of KVM_RUN"},
            {"syscall": "tkill", "comment": "safety net: the abort path"},
            {"syscall": "rseq", "comment": "glibc restartable sequences, per thread"},
            {"syscall": "set_robust_list", "comment": "glibc thread startup"},
            {"syscall": "sigaltstack", "comment": "std thread startup and teardown"},
            {"syscall": "rt_sigaction", "comment": "std signal setup on the reader threads"},
            {"syscall": "rt_sigprocmask", "comment": "std thread startup"},
            {"syscall": "rt_sigreturn", "comment": "returning from the vCPU kick signal"},
            {"syscall": "restart_syscall", "comment": "safety net: a read interrupted by the kick"},
            {"syscall": "exit", "comment": "thread exit"},
            {"syscall": "exit_group", "comment": "process exit"}
        ]
    },
    "vcpu": {
        "default_action": "trap",
        "filter_action": "allow",
        "filter": [
            {"syscall": "ioctl", "comment": "KVM_RUN, KVM_IRQ_LINE and the register reads"},
            {"syscall": "write", "comment": "guest console bytes and the event ledger"},
            {"syscall": "pread64", "comment": "virtio-blk serviced inline on an MMIO exit"},
            {"syscall": "read", "comment": "a plugin doorbell drained at the safe point; this thread already holds write and pread64, so read on an fd it inherited adds no authority"},
            {"syscall": "pwrite64", "comment": "same, for writes"},
            {"syscall": "writev", "comment": "safety net: BufWriter flush of the ledger"},
            {"syscall": "lseek", "comment": "safety net: File::seek on the backing file"},
            {"syscall": "fdatasync", "comment": "a guest flush request serviced inline (sync_data)"},
            {"syscall": "fsync", "comment": "safety net: sync_all on the same path"},
            {"syscall": "sendto", "comment": "gateway TX from the device on an MMIO exit"},
            {"syscall": "futex", "comment": "the device and ledger locks"},
            {"syscall": "ppoll", "comment": "the plugin waker, the readers and any timer thread"},
            {"syscall": "mmap", "comment": "allocator growth inside a device"},
            {"syscall": "munmap", "comment": "allocator release"},
            {"syscall": "mprotect", "comment": "allocator"},
            {"syscall": "mremap", "comment": "safety net: realloc of a frame buffer"},
            {"syscall": "madvise", "comment": "allocator returning pages"},
            {"syscall": "brk", "comment": "glibc malloc"},
            {"syscall": "getrandom", "comment": "HashMap seeding inside a device"},
            {"syscall": "getpid", "comment": "the tgkill kick from cpu0"},
            {"syscall": "gettid", "comment": "thread startup"},
            {"syscall": "tgkill", "comment": "cpu0 kicking the other vCPUs to quiesce"},
            {"syscall": "tkill", "comment": "safety net: the abort path"},
            {"syscall": "sched_yield", "comment": "safety net: lock contention with a reader"},
            {"syscall": "sched_getaffinity", "comment": "thread startup"},
            {"syscall": "rseq", "comment": "glibc restartable sequences"},
            {"syscall": "set_robust_list", "comment": "thread startup"},
            {"syscall": "sigaltstack", "comment": "thread startup and teardown"},
            {"syscall": "rt_sigprocmask", "comment": "thread startup"},
            {"syscall": "rt_sigreturn", "comment": "returning from the kick signal"},
            {"syscall": "rt_sigaction", "comment": "safety net: std signal setup"},
            {"syscall": "restart_syscall", "comment": "safety net: an ioctl interrupted by the kick"},
            {"syscall": "clock_gettime", "comment": "safety net: event timestamps"},
            {"syscall": "close", "comment": "safety net: a device dropping a descriptor"},
            {"syscall": "exit", "comment": "thread exit"},
            {"syscall": "exit_group", "comment": "process exit on a guest power-off"}
        ]
    }
}
