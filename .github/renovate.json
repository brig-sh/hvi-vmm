{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":gitSignOff",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)",
    ":semanticCommitScope(deps)"
  ],
  "prHourlyLimit": 5,
  "labels": ["dependencies"],
  "commitMessageLowerCase": "never",
  "commitBodyTable": true,
  "customManagers": [
    {
      "description": "Bump the cargo-deny pin, which sits in an action input the github-actions manager does not read.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/actions/cargo-deny/action\\.yml$/"],
      "matchStrings": ["# renovate: datasource=crate depName=cargo-deny\\s+tool: cargo-deny@(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "crate",
      "depNameTemplate": "cargo-deny"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the SHA-pinned actions bumped.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "semanticCommitType": "ci"
    },
    {
      "description": "Keep the Cargo dependencies bumped; the lockfile is committed.",
      "matchManagers": ["cargo"],
      "groupName": "cargo dependencies"
    },
    {
      "description": "Keep the commitlint tooling under .github/linters bumped.",
      "matchManagers": ["npm"],
      "groupName": "commitlint",
      "semanticCommitType": "ci"
    }
  ]
}
