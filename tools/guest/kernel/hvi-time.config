# hvi-time guest kernel fragment, merged over the published urunc-kernel:minimal
# 6.12.95 config (p0/kernel/guest.config) with scripts/kconfig/merge_config.sh.
CONFIG_HVI_TIME=y
CONFIG_ARM_ARCH_TIMER=y
# SOCK_DESTROY over inet_diag (the "ss -K" call). After a move the guest's
# agent closes every TCP connection to a peer off the guest: the old host's
# network is gone, and a connection the guest only reads from would wait
# a minute for its own timers.
CONFIG_INET_DIAG_DESTROY=y
